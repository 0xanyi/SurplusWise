#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

export DEBIAN_FRONTEND=noninteractive
export NEXT_TELEMETRY_DISABLED=1

echo "[setup] Checking Node.js"
node_version="$(node --version 2>/dev/null || true)"
node_major="$(sed -E 's/^v([0-9]+).*/\1/' <<<"${node_version:-v0}")"
node_minor="$(sed -E 's/^v[0-9]+\.([0-9]+).*/\1/' <<<"${node_version:-v0.0}")"
if (( node_major < 22 || (node_major == 22 && node_minor < 13) || node_major == 23 )); then
  node_release="22.14.0"
  echo "[setup] Installing Node.js $node_release"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends ca-certificates curl xz-utils

  case "$(uname -m)" in
    x86_64) node_arch="x64" ;;
    aarch64) node_arch="arm64" ;;
    *) echo "[setup] Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac

  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL "https://nodejs.org/dist/v$node_release/node-v$node_release-linux-$node_arch.tar.xz" -o "$archive"
  sudo rm -rf "/opt/node-v$node_release"
  sudo mkdir -p "/opt/node-v$node_release"
  sudo tar -xJf "$archive" --strip-components=1 -C "/opt/node-v$node_release"
  for executable in node npm npx corepack; do
    sudo ln -sfn "/opt/node-v$node_release/bin/$executable" "/usr/local/bin/$executable"
  done
  rm -f "$archive"
  trap - EXIT
fi

if [[ ! -d /etc/postgresql/16/main ]]; then
  echo "[setup] Installing PostgreSQL 16"
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends ca-certificates curl
  sudo install -d -m 0755 /usr/share/postgresql-common/pgdg
  sudo curl -fsSL \
    -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc \
    https://www.postgresql.org/media/keys/ACCC4CF8.asc
  echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" \
    | sudo tee /etc/apt/sources.list.d/pgdg.list >/dev/null
  sudo apt-get update
  sudo apt-get install -y --no-install-recommends postgresql-16
fi

echo "[setup] Starting PostgreSQL"
if ! sudo pg_ctlcluster 16 main status >/dev/null 2>&1; then
  sudo pg_ctlcluster 16 main start
fi

echo "[setup] Provisioning local database"
if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = 'surpluswise'" | grep -q 1; then
  sudo -u postgres psql -v ON_ERROR_STOP=1 \
    -c "CREATE ROLE surpluswise LOGIN PASSWORD 'localdev'"
else
  sudo -u postgres psql -v ON_ERROR_STOP=1 \
    -c "ALTER ROLE surpluswise WITH LOGIN PASSWORD 'localdev'" >/dev/null
fi

if ! sudo -u postgres psql -tAc "SELECT 1 FROM pg_database WHERE datname = 'surpluswise'" | grep -q 1; then
  sudo -u postgres createdb --owner=surpluswise surpluswise
fi

if [[ ! -f .env.local ]]; then
  echo "[setup] Creating .env.local with orb development defaults"
  umask 077
  auth_secret="$(openssl rand -base64 32)"
  cat > .env.local <<EOF
DATABASE_URL=postgresql://surpluswise:localdev@localhost:5432/surpluswise
BETTER_AUTH_SECRET=$auth_secret
NEXT_PUBLIC_SITE_URL=http://localhost:3000
OPENAI_API_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
EOF
fi

echo "[setup] Installing npm dependencies"
npm ci --legacy-peer-deps

echo "[setup] Applying database migrations"
DATABASE_URL=postgresql://surpluswise:localdev@localhost:5432/surpluswise npm run db:migrate

echo "[setup] Complete"
